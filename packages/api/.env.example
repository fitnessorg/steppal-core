# Copy to .env. Nothing here is a real credential.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Any Postgres. A hosted one (Neon, Supabase, Railway) needs ?sslmode=require.
DATABASE_URL=postgres://steppal:steppal@localhost:5432/steppal

# Signs access tokens. Any long random string in development; a secret you
# actually keep secret in production, because anyone holding it can mint a
# session for any user.
JWT_SECRET=change-me-to-something-long-and-random

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# console logs the code to stdout — the default, and what the tests use.
# termii is the Nigerian SMS provider.
SMS_PROVIDER=console
# TERMII_API_KEY=
# TERMII_SENDER_ID=StepPal

# mock credits instantly and moves no money. paystack targets real or sandbox API.
PAYMENT_PROVIDER=mock
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_PUBLIC_KEY=pk_test_...
# PAYSTACK_BASE_URL=https://api.paystack.co

# mock runs escrow in memory. soroban submits transactions to Stellar Soroban RPC.
ESCROW_PROVIDER=mock
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
GOAL_ESCROW_CONTRACT_ID=CCEMDKD4POJ4H2EF3JSY73W33OVB34X7KWV7UM6VRESTPNTHJ4OG37TT
# ORACLE_SECRET_KEY=S...
# ORACLE_PUBLIC_KEY=G...

# Steps above this are clamped, not rejected, and the raw figure is kept.
DAILY_STEP_CAP=25000
