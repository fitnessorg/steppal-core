{
  "name": "@steppal/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/phone.test.ts test/sms.test.ts test/otp.test.ts test/pots-pagination.test.ts test/payments.test.ts test/settlement-pure.test.ts test/escrow.test.ts test/settlement-coordinator.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "settle": "tsx src/jobs/settle.ts",
    "settle:recover": "tsx src/jobs/recover-settlements.ts",
    "prune:otp": "tsx src/jobs/prune-otp.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.12",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "vitest": "^5.0.0"
  }
}
