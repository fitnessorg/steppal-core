# Copy this file to .env and adjust as needed.
# .env is gitignored — never commit real secrets.

# --- Server ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- Database ---
# Matches the postgres service in docker-compose.yml by default.
DATABASE_URL=postgres://steppal:steppal@localhost:5432/steppal

# --- Auth ---
# Secret used to sign short-lived access tokens (HS256 JWT). Generate a real
# random value for anything beyond local dev, e.g. `openssl rand -hex 32`.
JWT_SECRET=dev-only-change-me
# Access token lifetime, in seconds. 15 minutes.
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime, in seconds. 30 days.
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- SMS provider ---
# "console" (default, logs OTP codes to stdout) or "termii" (not implemented, see TODO(contributor)).
SMS_PROVIDER=console

# --- Payment provider ---
# "mock" (default, instant local credit, no network) or "paystack" (stubbed, see TODO(contributor)).
PAYMENT_PROVIDER=mock

# --- Step validation ---
# Max steps counted per day before the excess is clamped (not rejected).
DAILY_STEP_CAP=25000
